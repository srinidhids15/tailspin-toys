---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Set(games.flatMap((game) => game.category ? [game.category.name] : []))].sort();
const publishers = [...new Set(games.flatMap((game) => game.publisher ? [game.publisher.name] : []))].sort();
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
          <p class="mt-1 text-sm text-slate-400" data-testid="game-count" aria-live="polite">
            Showing {games.length} of {games.length} games
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-end" data-testid="game-filters">
          <label class="flex flex-col gap-1 text-sm text-slate-300">
            <span>Category</span>
            <select
              class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="category-filter"
            >
              <option value="">All categories</option>
              {categories.map((category) => <option value={category}>{category}</option>)}
            </select>
          </label>
          <label class="flex flex-col gap-1 text-sm text-slate-300">
            <span>Publisher</span>
            <select
              class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-500"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher}>{publisher}</option>)}
            </select>
          </label>
          <button
            type="button"
            class="rounded-lg border border-slate-600 px-3 py-2 text-sm font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
            data-testid="clear-filters"
          >
            Clear filters
          </button>
        </div>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const categoryFilter = document.querySelector<HTMLSelectElement>('[data-testid="category-filter"]');
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const clearFilters = document.querySelector<HTMLButtonElement>('[data-testid="clear-filters"]');
  const gameCount = document.querySelector<HTMLElement>('[data-testid="game-count"]');
  const gameCards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];

  const updateGames = () => {
    const category = categoryFilter?.value ?? "";
    const publisher = publisherFilter?.value ?? "";
    let visibleCount = 0;

    for (const card of gameCards) {
      const matchesCategory = !category || card.dataset.gameCategory === category;
      const matchesPublisher = !publisher || card.dataset.gamePublisher === publisher;
      const isVisible = matchesCategory && matchesPublisher;
      card.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    }

    if (gameCount) {
      gameCount.textContent = `Showing ${visibleCount} of ${gameCards.length} games`;
    }
  };

  categoryFilter?.addEventListener("change", updateGames);
  publisherFilter?.addEventListener("change", updateGames);
  clearFilters?.addEventListener("click", () => {
    if (categoryFilter) categoryFilter.value = "";
    if (publisherFilter) publisherFilter.value = "";
    updateGames();
  });
</script>
